---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCover } from "@/utils/postCover";
import { getCategoryMeta } from "@/utils/categories";
import { getReadingTimeMinutes } from "@/utils/readingTime";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  post: CollectionEntry<"posts">;
  sidePosts?: CollectionEntry<"posts">[];
};

const { post, sidePosts = [] } = Astro.props;
const { data } = post;
const locale = Astro.currentLocale ?? config.site.lang;
const cover = getPostCover(post);
const category = getCategoryMeta(data.tags?.[0]);
const readingTime = getReadingTimeMinutes(post.body);
const postUrl = getPostUrl(post.id, post.filePath, locale);
---

<section
  aria-label="Portada del día"
  class="grid grid-cols-1 gap-5 lg:grid-cols-12"
>
  <!-- Lead Story -->
  <article
    class:list={[
      "group bg-surface border-border hover:border-accent/60 relative flex flex-col overflow-hidden rounded-3xl border shadow-xs transition-all duration-200 hover:shadow-lg",
      sidePosts.length > 0 ? "lg:col-span-7" : "lg:col-span-12",
    ]}
  >
    <a
      href={postUrl}
      class="bg-muted relative block aspect-[16/9] overflow-hidden"
    >
      {
        cover?.image && !cover.isSvg ? (
          <Image
            src={cover.image}
            alt=""
            width={960}
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : cover?.url ? (
          <img
            src={cover.url}
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : (
          <div
            class:list={[
              "absolute inset-0 flex items-center justify-center bg-linear-to-br",
              category.gradientClass,
            ]}
          >
            <span class="font-mono text-4xl font-bold tracking-widest text-white/60 uppercase">
              {category.label}
            </span>
          </div>
        )
      }
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-black/45 to-transparent"
      >
      </div>
      <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2">
        <span
          class="font-mono inline-flex items-center gap-1.5 rounded-full bg-slate-950/80 px-3 py-1 text-[11px] font-semibold tracking-wider text-sky-300 uppercase backdrop-blur-md"
        >
          <span class="size-1.5 rounded-full bg-sky-400" aria-hidden="true"
          ></span>
          En portada
        </span>
      </div>
    </a>

    <div class="flex flex-1 flex-col p-5 sm:p-7">
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={getRelativeLocaleUrl(locale, `tags/${category.slug}`)}
          class:list={[
            "font-mono inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold tracking-wide uppercase transition-opacity hover:opacity-85",
            category.chipClass,
          ]}
        >
          <span
            class:list={["size-1.5 rounded-full", category.dotClass]}
            aria-hidden="true"></span>
          {category.label}
        </a>
        <Datetime {...data} readingTime={readingTime} />
      </div>

      <h2
        class="font-display text-foreground mt-3.5 text-2xl leading-tight font-extrabold tracking-tight sm:text-[1.75rem]"
      >
        <a href={postUrl} class="hover:text-accent transition-colors">
          {data.title}
        </a>
      </h2>

      <p
        class="text-muted-foreground mt-3 line-clamp-3 text-sm leading-relaxed sm:text-[0.95rem]"
      >
        {data.description}
      </p>

      <div class="mt-auto pt-5">
        <a
          href={postUrl}
          class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold shadow-xs transition-opacity hover:opacity-90"
        >
          Leer noticia completa
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>

  <!-- Right Briefing Column (5 clean text-only headlines stacked consistently) -->
  {
    sidePosts.length > 0 && (
      <div class="bg-surface border-border flex flex-col rounded-3xl border p-5 shadow-xs sm:p-6 lg:col-span-5">
        <div class="border-border flex items-center justify-between border-b pb-3">
          <div class="flex items-center gap-2">
            <span class="bg-accent size-2 rounded-full" aria-hidden="true" />
            <h2 class="font-mono text-foreground text-xs font-bold tracking-wider uppercase">
              Pulso reciente
            </h2>
          </div>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="font-mono text-accent text-xs font-semibold hover:underline"
          >
            Ver todo →
          </a>
        </div>

        <ul class="divide-border divide-y">
          {sidePosts.map(item => {
            const itemCat = getCategoryMeta(item.data.tags?.[0]);
            const itemUrl = getPostUrl(item.id, item.filePath, locale);
            const itemRead = getReadingTimeMinutes(item.body);
            return (
              <li class="py-3 first:pt-3.5 last:pb-0">
                <a href={itemUrl} class="group block">
                  <div class="flex items-center justify-between gap-2">
                    <span
                      class:list={[
                        "font-mono inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[10px] font-semibold tracking-wide uppercase",
                        itemCat.chipClass,
                      ]}
                    >
                      <span
                        class:list={["size-1.5 rounded-full", itemCat.dotClass]}
                        aria-hidden="true"
                      />
                      {itemCat.label}
                    </span>
                    <Datetime {...item.data} readingTime={itemRead} />
                  </div>
                  <h3 class="font-display text-foreground group-hover:text-accent mt-1.5 line-clamp-2 text-[0.95rem] leading-snug font-bold tracking-tight transition-colors">
                    {item.data.title}
                  </h3>
                  <p class="text-muted-foreground mt-1 line-clamp-1 text-xs leading-relaxed">
                    {item.data.description}
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>
