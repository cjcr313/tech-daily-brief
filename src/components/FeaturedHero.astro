---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCover } from "@/utils/postCover";
import Datetime from "./Datetime.astro";

type Props = { post: CollectionEntry<"posts"> };

const { post } = Astro.props;
const { data } = post;
const cover = getPostCover(post);
const tag = data.tags?.[0] ?? "ia";
const postUrl = getPostUrl(post.id, post.filePath, Astro.currentLocale);

const coverGradients: Record<string, string> = {
  kubernetes: "from-[#0c4a6e] via-[#2563eb] to-[#7dd3fc]",
  cloud: "from-[#0c4a6e] via-[#0284c7] to-[#38bdf8]",
  seguridad: "from-[#7f1d1d] via-[#dc2626] to-[#f97316]",
  observabilidad: "from-[#78350f] via-[#d97706] to-[#facc15]",
  ia: "from-[#4c1d95] via-[#7c3aed] to-[#0ea5e9]",
  devops: "from-[#14532d] via-[#16a34a] to-[#4ade80]",
  infraestructura: "from-[#1e293b] via-[#475569] to-[#94a3b8]",
  arquitectura: "from-[#134e4a] via-[#0d9488] to-[#5eead4]",
};
---

<section
  class="grid items-center gap-6 overflow-hidden rounded-3xl border border-border bg-muted/40 p-5 sm:p-7 md:grid-cols-[1.15fr_1fr] md:p-8"
>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-bold tracking-wider text-accent-foreground uppercase"
      >
        ★ Destacado de la semana
      </span>
      <span
        class="rounded-full border border-border px-2.5 py-0.5 text-[11px] font-semibold tracking-wider text-muted-foreground uppercase"
      >
        {tag}
      </span>
    </div>
    <h2 class="mt-4 text-2xl leading-tight font-bold tracking-tight sm:text-3xl">
      <a href={postUrl} class="transition-colors hover:text-accent">
        {data.title}
      </a>
    </h2>
    <p class="mt-3 line-clamp-3 text-muted-foreground sm:text-base">
      {data.description}
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
      <Datetime {...data} />
      <a
        href={postUrl}
        class="rounded-full bg-accent px-4 py-1.5 text-sm font-semibold text-accent-foreground transition-opacity hover:opacity-85"
      >
        Leer noticia →
      </a>
    </div>
  </div>
  <a href={postUrl} class="relative aspect-[16/10] overflow-hidden rounded-2xl border border-border">
    {
      cover ? (
        <img
          src={cover}
          alt=""
          loading="eager"
          decoding="async"
          class="absolute inset-0 size-full object-cover"
        />
      ) : (
        <div
          class:list={[
            "absolute inset-0 flex items-center justify-center bg-linear-to-br",
            coverGradients[tag] ?? coverGradients["ia"],
          ]}
        >
          <span class="text-5xl font-bold tracking-widest text-white/60 uppercase">
            {tag}
          </span>
        </div>
      )
    }
  </a>
</section>
