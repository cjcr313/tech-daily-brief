---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import "dayjs/locale/es";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  readingTime?: number;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  readingTime,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime)
  .tz(postTimezone ?? config.site.timezone)
  .locale(locale === "en" ? "en" : "es");

const formattedDate = datetime
  .format("D MMM, YYYY")
  .replace(/\.$/, "")
  .replace(/\.,/, ",");
---

<div
  class:list={[
    "text-muted-foreground font-mono flex flex-wrap items-center gap-x-2 gap-y-0.5",
    size === "lg" ? "text-xs sm:text-sm" : "text-xs",
    className,
  ]}
>
  {isModified && <span>{t.post.updatedAt}</span>}
  <time datetime={datetime.toISOString()}>{formattedDate}</time>
  {
    typeof readingTime === "number" && (
      <>
        <span aria-hidden="true" class="opacity-45">
          ·
        </span>
        <span>{readingTime} min</span>
      </>
    )
  }
</div>
