---
import { getAssetPath } from "@/utils/withBase";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconX from "@/assets/icons/IconX.svg";
import "@pagefind/default-ui/css/ui.css";

const bundlePath = getAssetPath("pagefind/");
---

<dialog
  id="search-dialog"
  closedby="any"
  aria-labelledby="search-dialog-title"
  data-bundle-path={bundlePath}
  class="search-modal bg-surface text-foreground border-border m-auto mt-16 max-h-[82svh] w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-2xl border p-0 shadow-2xl backdrop:bg-slate-950/60"
>
  <div class="border-border flex items-center justify-between border-b px-4 py-3 sm:px-5">
    <div class="flex items-center gap-2.5">
      <IconSearch class="text-accent size-5 shrink-0" />
      <h2 id="search-dialog-title" class="text-sm font-semibold">
        Buscar en Ping Diario
      </h2>
    </div>
    <button
      type="button"
      id="close-search-dialog"
      class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-xs font-medium transition-colors"
      aria-label="Cerrar buscador"
    >
      <span class="font-mono hidden text-[11px] sm:inline">ESC</span>
      <IconX class="size-4" />
    </button>
  </div>

  <div class="max-h-[calc(82svh-3.5rem)] overflow-y-auto p-4 sm:p-5">
    <div id="modal-pagefind-container"></div>
  </div>
</dialog>

<script>
  let pagefindMounted = false;

  async function mountModalPagefind(dialog: HTMLDialogElement) {
    if (pagefindMounted) return;
    const container = dialog.querySelector<HTMLElement>(
      "#modal-pagefind-container"
    );
    const bundlePath = dialog.dataset.bundlePath;
    if (!container || !bundlePath) return;

    pagefindMounted = true;
    try {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");
      new PagefindUI({
        element: "#modal-pagefind-container",
        bundlePath,
        showImages: false,
        showSubResults: false,
        translations: {
          placeholder: "Buscar noticias, CVEs, Kubernetes, IA, AWS...",
          clear_search: "Limpiar",
          load_more: "Cargar más resultados",
          search_label: "Buscar en Ping Diario",
          zero_results: "Sin resultados para «[SEARCH_TERM]»",
          many_results: "[COUNT] resultados para «[SEARCH_TERM]»",
          one_result: "1 resultado para «[SEARCH_TERM]»",
          searching: "Buscando «[SEARCH_TERM]»...",
        },
      });
    } catch {
      container.innerHTML =
        '<p class="text-sm text-muted-foreground">El buscador está disponible después de compilar el sitio. <a href="/search/" class="text-accent underline">Ir a la página de búsqueda</a>.</p>';
    }
  }

  function openSearchDialog() {
    const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
    if (!dialog || dialog.open) return;
    dialog.showModal();
    mountModalPagefind(dialog).then(() => {
      const input = dialog.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input"
      );
      input?.focus();
    });
  }

  function setupSearchModal() {
    const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
    if (!dialog) return;

    // Reset mount flag if DOM was swapped by View Transitions
    if (!dialog.querySelector(".pagefind-ui")) {
      pagefindMounted = false;
    }

    const closeBtn = dialog.querySelector<HTMLButtonElement>(
      "#close-search-dialog"
    );
    if (closeBtn && closeBtn.dataset.bound !== "true") {
      closeBtn.dataset.bound = "true";
      closeBtn.addEventListener("click", () => dialog.close());
    }

    // Mandatory fallback for browsers without native <dialog closedby="any">
    if (
      !("closedBy" in HTMLDialogElement.prototype) &&
      dialog.dataset.lightDismissBound !== "true"
    ) {
      dialog.dataset.lightDismissBound = "true";
      dialog.addEventListener("click", event => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (isDialogContent) return;
        dialog.close();
      });
    }

    // Close modal when clicking a search result link
    if (dialog.dataset.resultNavBound !== "true") {
      dialog.dataset.resultNavBound = "true";
      dialog.addEventListener("click", event => {
        const target = event.target as HTMLElement | null;
        if (target?.closest("a[href]")) {
          dialog.close();
        }
      });
    }

    // Bind all trigger buttons
    document
      .querySelectorAll<HTMLElement>("[data-open-search]")
      .forEach(trigger => {
        if (trigger.dataset.searchBound === "true") return;
        trigger.dataset.searchBound = "true";
        trigger.addEventListener("click", event => {
          event.preventDefault();
          openSearchDialog();
        });
      });
  }

  // Global keyboard shortcut Cmd+K / Ctrl+K (registered once)
  if (!(window as unknown as { __searchShortcutBound?: boolean }).__searchShortcutBound) {
    (window as unknown as { __searchShortcutBound?: boolean }).__searchShortcutBound = true;
    document.addEventListener("keydown", event => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openSearchDialog();
      }
    });
  }

  setupSearchModal();
  document.addEventListener("astro:page-load", setupSearchModal);
</script>

<style is:global>
  #modal-pagefind-container {
    --pagefind-ui-scale: 0.92;
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-border-width: 1px;

    .pagefind-ui__search-input {
      background-color: var(--background);
      color: var(--foreground);
      font-weight: 400;
    }

    .pagefind-ui__search-input:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    .pagefind-ui__result-link {
      color: var(--foreground);
      font-weight: 600;
    }

    .pagefind-ui__result-link:hover {
      color: var(--accent);
    }

    .pagefind-ui__result-excerpt mark {
      background-color: var(--accent-soft);
      color: var(--foreground);
      border-radius: 0.25rem;
      padding: 0 0.2rem;
    }
  }
</style>
