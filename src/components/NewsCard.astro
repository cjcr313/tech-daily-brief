---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCover } from "@/utils/postCover";
import { getCategoryMeta } from "@/utils/categories";
import { getReadingTimeMinutes } from "@/utils/readingTime";
import Datetime from "./Datetime.astro";

type Props = { post: CollectionEntry<"posts"> };

const { post } = Astro.props;
const { data } = post;
const cover = getPostCover(post);
const category = getCategoryMeta(data.tags?.[0]);
const readingTime = getReadingTimeMinutes(post.body);
const postUrl = getPostUrl(post.id, post.filePath, Astro.currentLocale);
---

<li class="min-w-0">
  <a
    href={postUrl}
    class="group bg-surface border-border hover:border-accent/60 flex h-full flex-col overflow-hidden rounded-2xl border shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
  >
    <div class="bg-muted relative aspect-video overflow-hidden">
      {
        cover?.image && !cover.isSvg ? (
          <Image
            src={cover.image}
            alt=""
            width={640}
            format="webp"
            quality={78}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        ) : cover?.url ? (
          <img
            src={cover.url}
            alt=""
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        ) : (
          <div
            class:list={[
              "absolute inset-0 flex items-center justify-center bg-linear-to-br",
              category.gradientClass,
            ]}
          >
            <span class="font-mono text-2xl font-bold tracking-widest text-white/60 uppercase">
              {category.label}
            </span>
          </div>
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-2.5 p-4 sm:p-5">
      <div class="flex items-center justify-between gap-2">
        <span
          class:list={[
            "font-mono inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold tracking-wide uppercase",
            category.chipClass,
          ]}
        >
          <span
            class:list={["size-1.5 rounded-full", category.dotClass]}
            aria-hidden="true"></span>
          {category.label}
        </span>
      </div>

      <h3
        class="font-display text-foreground group-hover:text-accent line-clamp-2 text-[1.05rem] leading-snug font-bold tracking-tight transition-colors"
      >
        {data.title}
      </h3>

      <p class="text-muted-foreground line-clamp-2 text-sm leading-relaxed">
        {data.description}
      </p>

      <div
        class="border-border/70 mt-auto flex items-center justify-between border-t pt-3"
      >
        <Datetime {...data} readingTime={readingTime} />
        <span
          class="font-mono text-accent text-xs font-semibold transition-transform group-hover:translate-x-0.5"
        >
          Leer →
        </span>
      </div>
    </div>
  </a>
</li>
