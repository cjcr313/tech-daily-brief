---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  page: Page<CollectionEntry<"posts">>;
  /** Ruta de la lista paginada. Vacío = paginación en la home (raíz). */
  base?: string;
};

const { page, base = "posts" } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;

const current = page.currentPage;
const last = page.lastPage;

// Ventana de páginas numeradas: hasta 11 números, garantizando primera y última.
const MAX = 11;
const wanted = new Set<number>([1, last]);
if (last <= MAX + 1) {
  for (let n = 1; n <= last; n++) wanted.add(n);
} else if (current <= MAX - 3) {
  for (let n = 1; n <= MAX; n++) wanted.add(n);
} else if (current >= last - MAX + 4) {
  for (let n = last - MAX + 1; n <= last; n++) wanted.add(n);
} else {
  for (let n = current - 3; n <= current + 3; n++) wanted.add(n);
}
const nums = [...wanted].filter(n => n >= 1 && n <= last).sort((a, b) => a - b);

type PageItem = number | "…";
const items: PageItem[] = [];
let prev = 0;
for (const n of nums) {
  if (prev && n - prev > 1) items.push("…");
  items.push(n);
  prev = n;
}

const pageHref = (n: number) =>
  n === 1
    ? getRelativeLocaleUrl(locale, base)
    : getRelativeLocaleUrl(locale, `${base ? `${base}/` : ""}${n}`);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex flex-wrap items-center justify-between gap-3"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["select-none", { "opacity-50": !page.url.prev }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>

      <ul class="flex flex-1 flex-wrap items-center justify-center gap-1">
        {items.map(item =>
          item === "…" ? (
            <li class="text-muted-foreground px-1 select-none" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              <a
                href={pageHref(item)}
                aria-current={item === current ? "page" : undefined}
                class:list={[
                  "inline-flex size-8 items-center justify-center rounded-md text-sm transition-colors",
                  item === current
                    ? "bg-accent font-semibold text-accent-foreground"
                    : "hover:text-accent",
                ]}
              >
                {item}
              </a>
            </li>
          )
        )}
      </ul>

      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["select-none", { "opacity-50": !page.url.next }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
