---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  page: Page<CollectionEntry<"posts">>;
  /** Ruta de la lista paginada. Vacío = paginación en la home (raíz). */
  base?: string;
};

const { page, base = "posts" } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;

const current = page.currentPage;
const last = page.lastPage;

// Todas las páginas visibles: 1..última, sin ventana ni puntos suspensivos.
const items: number[] = Array.from({ length: last }, (_, i) => i + 1);

const pageHref = (n: number) =>
  n === 1
    ? getRelativeLocaleUrl(locale, base)
    : getRelativeLocaleUrl(locale, `${base ? `${base}/` : ""}${n}`);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex flex-col gap-3"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <div class="flex items-center justify-between">
        <LinkButton
          disabled={!page.url.prev}
          href={page.url.prev as string}
          class:list={["select-none", { "opacity-50": !page.url.prev }]}
          aria-label={t.a11y.goToPreviousPage}
        >
          <IconArrowLeft class="inline-block rtl:rotate-180" />
          {t.pagination.prev}
        </LinkButton>

        <LinkButton
          disabled={!page.url.next}
          href={page.url.next as string}
          class:list={["select-none", { "opacity-50": !page.url.next }]}
          aria-label={t.a11y.goToNextPage}
        >
          {t.pagination.next}
          <IconArrowRight class="inline-block rtl:rotate-180" />
        </LinkButton>
      </div>

      <ul class="flex flex-wrap items-center justify-between gap-1">
        {items.map(item => (
          <li>
            <a
              href={pageHref(item)}
              aria-current={item === current ? "page" : undefined}
              class:list={[
                "inline-flex size-8 items-center justify-center rounded-md text-sm transition-colors",
                item === current
                  ? "bg-accent font-semibold text-accent-foreground"
                  : "hover:text-accent",
              ]}
            >
              {item}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
