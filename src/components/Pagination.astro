---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  page: Page<CollectionEntry<"posts">>;
  /** Ruta de la lista paginada. Vacío = paginación en la home (raíz). */
  base?: string;
};

const { page, base = "posts" } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;

const current = page.currentPage;
const last = page.lastPage;

// Fallback sin JS: primera, última y vecinas de la actual (siempre una línea).
const wanted = new Set([1, last, current - 1, current, current + 1]);
const nums = [...wanted].filter(n => n >= 1 && n <= last).sort((a, b) => a - b);

type PageItem = number | "…";
const fallback: PageItem[] = [];
let prev = 0;
for (const n of nums) {
  if (prev && n - prev > 1) fallback.push("…");
  fallback.push(n);
  prev = n;
}

const pageHref = (n: number) =>
  n === 1
    ? getRelativeLocaleUrl(locale, base)
    : getRelativeLocaleUrl(locale, `${base ? `${base}/` : ""}${n}`);

const basePath = getRelativeLocaleUrl(locale, base);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <div id="pag-row" class="flex items-center justify-between gap-3">
        <LinkButton
          disabled={!page.url.prev}
          href={page.url.prev as string}
          class:list={[
            "flex-none select-none",
            { "opacity-50": !page.url.prev },
          ]}
          aria-label={t.a11y.goToPreviousPage}
        >
          <IconArrowLeft class="inline-block rtl:rotate-180" />
          {t.pagination.prev}
        </LinkButton>

        <ul
          id="pag-nums"
          class="flex min-w-0 flex-1 items-center justify-center gap-1 overflow-hidden"
          data-current={current}
          data-last={last}
          data-base={basePath}
        >
          {fallback.map(item =>
            item === "…" ? (
              <li
                class="text-muted-foreground px-1 text-sm select-none"
                aria-hidden="true"
              >
                …
              </li>
            ) : (
              <li>
                <a
                  href={pageHref(item)}
                  aria-current={item === current ? "page" : undefined}
                  class:list={[
                    "inline-flex size-7 items-center justify-center rounded-md text-xs transition-colors",
                    item === current
                      ? "bg-accent font-semibold text-accent-foreground"
                      : "hover:text-accent",
                  ]}
                >
                  {item}
                </a>
              </li>
            )
          )}
        </ul>

        <LinkButton
          disabled={!page.url.next}
          href={page.url.next as string}
          class:list={[
            "flex-none select-none",
            { "opacity-50": !page.url.next },
          ]}
          aria-label={t.a11y.goToNextPage}
        >
          {t.pagination.next}
          <IconArrowRight class="inline-block rtl:rotate-180" />
        </LinkButton>
      </div>
    </nav>
  )
}

<script>
  function range(from: number, to: number): number[] {
    return Array.from({ length: to - from + 1 }, (_, i) => from + i);
  }

  /**
   * Ajusta la lista de páginas para que quepa en UNA sola línea:
   * tantos números consecutivos como ancho haya, luego "…" y la última.
   * Si la página actual queda fuera, se desliza una ventana centrada.
   */
  function fitPagination() {
    const ul = document.querySelector<HTMLUListElement>("#pag-nums");
    const row = document.getElementById("pag-row");
    if (!ul || !row || row.children.length < 3) return;

    const antBtn = row.children[0] as HTMLElement;
    const sigBtn = row.children[row.children.length - 1] as HTMLElement;

    const current = Number(ul.dataset.current ?? 1);
    const last = Number(ul.dataset.last ?? 1);
    const basePath = ul.dataset.base ?? "/";

    const GAP = 4; // gap-1
    const CELL = 28 + GAP; // size-7 + gap

    const avail =
      row.clientWidth - antBtn.offsetWidth - sigBtn.offsetWidth - 24 - 8;

    let maxCells = Math.floor((avail + GAP) / CELL);
    if (maxCells < 5) maxCells = 5;

    const href = (n: number) => (n === 1 ? basePath : `${basePath}${n}/`);

    const list: (number | "…")[] = [];
    const budget = maxCells - 2; // reservado para "…" y la última

    if (last <= maxCells) {
      list.push(...range(1, last));
    } else if (current <= budget) {
      list.push(...range(1, budget), "…", last);
    } else {
      const win = Math.max(3, budget - 1);
      let start = current - Math.floor(win / 2);
      start = Math.max(2, Math.min(start, last - 1 - (win - 1)));
      const end = start + win - 1;
      list.push(1, "…", ...range(start, end));
      if (end < last - 1) list.push("…");
      list.push(last);
    }

    const fragment = document.createDocumentFragment();
    for (const item of list) {
      const li = document.createElement("li");
      if (item === "…") {
        li.className = "text-muted-foreground px-1 text-sm select-none";
        li.setAttribute("aria-hidden", "true");
        li.textContent = "…";
      } else {
        li.className = "flex-none";
        const a = document.createElement("a");
        a.href = href(item);
        a.textContent = String(item);
        if (item === current) a.setAttribute("aria-current", "page");
        a.className =
          item === current
            ? "inline-flex size-7 items-center justify-center rounded-md bg-accent text-xs font-semibold text-accent-foreground transition-colors"
            : "inline-flex size-7 items-center justify-center rounded-md text-xs transition-colors hover:text-accent";
        li.appendChild(a);
      }
      fragment.appendChild(li);
    }
    ul.replaceChildren(fragment);
  }

  fitPagination();
  document.addEventListener("astro:page-load", fitPagination);

  let resizeTimer: ReturnType<typeof setTimeout> | undefined;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(fitPagination, 150);
  });
</script>
