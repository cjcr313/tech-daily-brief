---
import config from "@/config";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const label =
      name === "instagram"
        ? "@pingdiario"
        : name.charAt(0).toUpperCase() + name.slice(1);
    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Escribir a ${site.title}`
        : `${site.title} en ${label}`);
    return { url, title, label, Icon };
  })
);
---

<div class="flex flex-wrap items-center gap-2">
  {
    items.map(({ url, title, label, Icon }) =>
      Icon ? (
        <a
          href={url}
          target={url.startsWith("http") ? "_blank" : undefined}
          rel={url.startsWith("http") ? "noopener noreferrer" : undefined}
          class="border-border bg-background text-muted-foreground hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors"
          title={title}
          aria-label={title}
        >
          <Icon class="size-3.5 fill-transparent stroke-current stroke-2" />
          <span>{label}</span>
        </a>
      ) : null
    )
  }
</div>
