---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconX from "@/assets/icons/IconX.svg";
import { CORE_CATEGORIES } from "@/utils/categories";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale) || "/";

const isHomeActive =
  currentPath === "/" || /^\/\d+$/.test(currentPath);

const isCategoryActive = (slug: string) =>
  currentPath === `/tags/${slug}` || currentPath.startsWith(`/tags/${slug}/`);

const isSectionActive = (prefix: string) =>
  currentPath === prefix || currentPath.startsWith(`${prefix}/`);

const rssUrl = getRelativeLocaleUrl(locale, "rss.xml");
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-surface text-accent border-border absolute inset-s-6 -top-full z-50 rounded-lg border px-3.5 py-2 text-sm font-medium shadow-md transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="border-border bg-background/85 sticky top-0 z-40 border-b backdrop-blur-md"
>
  <div class="app-layout">
    <!-- Top bar: Brand + Quick Actions -->
    <div class="flex h-15 items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="group flex items-center gap-2.5 whitespace-nowrap"
        >
          <span
            class="border-border bg-[#0b1120] relative flex size-8 shrink-0 items-center justify-center rounded-lg border shadow-xs transition-transform group-hover:scale-105"
            aria-hidden="true"
          >
            <svg viewBox="0 0 64 64" fill="none" class="size-6">
              <circle
                cx="32"
                cy="32"
                r="21"
                stroke="#0284C7"
                stroke-opacity="0.4"
                stroke-width="3"></circle>
              <path
                d="M47 32a15 15 0 0 1-15 15"
                stroke="#38BDF8"
                stroke-width="3.5"
                stroke-linecap="round"></path>
              <path
                d="M17 32a15 15 0 0 1 15-15"
                stroke="#38BDF8"
                stroke-width="3.5"
                stroke-linecap="round"></path>
              <circle cx="32" cy="32" r="5.5" fill="#38BDF8"></circle>
            </svg>
          </span>
          <span class="flex items-baseline gap-2">
            <span
              class="font-display text-foreground text-lg font-extrabold tracking-tight sm:text-xl"
            >
              {site.title}
            </span>
            <span
              class="font-mono text-muted-foreground hidden text-[11px] font-medium tracking-wider uppercase sm:inline"
            >
              Nauta Lab
            </span>
          </span>
        </a>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        {
          features.search !== false && (
            <a
              href={getRelativeLocaleUrl(locale, "search")}
              data-open-search
              class="border-border bg-surface text-muted-foreground hover:border-accent/60 hover:text-foreground inline-flex h-9 items-center gap-2 rounded-lg border px-2.5 text-sm transition-colors sm:px-3"
              title="Buscar artículos (⌘K)"
              aria-label="Buscar artículos"
            >
              <IconSearch class="size-4 shrink-0" />
              <span class="hidden text-xs sm:inline">Buscar...</span>
              <kbd class="font-mono bg-muted text-muted-foreground hidden rounded px-1.5 py-0.5 text-[10px] font-semibold md:inline">
                ⌘K
              </kbd>
            </a>
          )
        }

        <a
          href={rssUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground hover:bg-muted hover:text-accent inline-flex size-9 items-center justify-center rounded-lg transition-colors"
          title="Suscribirse por RSS"
          aria-label="Feed RSS de Ping Diario"
        >
          <IconRss class="size-4.5" />
        </a>

        {
          features.lightAndDarkMode && (
            <button
              id="theme-btn"
              type="button"
              class="text-muted-foreground hover:bg-muted hover:text-accent relative inline-flex size-9 items-center justify-center rounded-lg transition-colors"
              title={t.a11y.toggleTheme}
              aria-label={t.a11y.toggleTheme}
            >
              <IconMoon class="size-4.5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute size-4.5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }

        <button
          id="menu-btn"
          type="button"
          class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex size-9 items-center justify-center rounded-lg transition-colors lg:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconX id="close-icon" class="hidden size-5" />
          <IconMenuDeep id="menu-icon" class="size-5" />
        </button>
      </div>
    </div>

    <!-- Desktop category & section bar -->
    <nav
      aria-label="Categorías principales"
      class="border-border/70 hidden items-center justify-between gap-4 border-t py-2 lg:flex"
    >
      <ul class="flex flex-wrap items-center gap-1 text-sm">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "")}
            class:list={[
              "inline-flex items-center rounded-lg px-2.5 py-1 text-[13px] font-medium transition-colors",
              isHomeActive
                ? "active-nav"
                : "text-muted-foreground hover:bg-muted hover:text-foreground",
            ]}
          >
            Portada
          </a>
        </li>
        {
          CORE_CATEGORIES.map(cat => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${cat.slug}`)}
                class:list={[
                  "inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-[13px] font-medium transition-colors",
                  isCategoryActive(cat.slug)
                    ? "active-nav"
                    : "text-muted-foreground hover:bg-muted hover:text-foreground",
                ]}
              >
                {cat.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="flex shrink-0 items-center gap-1 text-xs">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "inline-flex items-center rounded-lg px-2 py-1 font-medium transition-colors",
              isSectionActive("/posts")
                ? "active-nav"
                : "text-muted-foreground hover:bg-muted hover:text-foreground",
            ]}
          >
            Todas
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "inline-flex items-center rounded-lg px-2 py-1 font-medium transition-colors",
              isSectionActive("/archives")
                ? "active-nav"
                : "text-muted-foreground hover:bg-muted hover:text-foreground",
            ]}
          >
            Archivo
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "inline-flex items-center rounded-lg px-2 py-1 font-medium transition-colors",
              isSectionActive("/about")
                ? "active-nav"
                : "text-muted-foreground hover:bg-muted hover:text-foreground",
            ]}
          >
            Acerca de
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile quick scrollable category rail -->
    <nav
      aria-label="Secciones rápidas"
      class="no-scrollbar border-border/70 -mx-4 flex items-center gap-1.5 overflow-x-auto border-t px-4 py-2 lg:hidden"
    >
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class:list={[
          "shrink-0 rounded-full px-3 py-1 text-xs font-medium transition-colors",
          isHomeActive
            ? "active-nav"
            : "bg-muted/70 text-muted-foreground hover:text-foreground",
        ]}
      >
        Portada
      </a>
      {
        CORE_CATEGORIES.map(cat => (
          <a
            href={getRelativeLocaleUrl(locale, `tags/${cat.slug}`)}
            class:list={[
              "shrink-0 rounded-full px-3 py-1 text-xs font-medium transition-colors",
              isCategoryActive(cat.slug)
                ? "active-nav"
                : "bg-muted/70 text-muted-foreground hover:text-foreground",
            ]}
          >
            {cat.label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile expandable menu drawer -->
    <div
      id="mobile-nav-drawer"
      class="border-border hidden border-t py-4 lg:hidden"
    >
      <p
        class="font-mono text-muted-foreground mb-2 text-[11px] font-semibold tracking-wider uppercase"
      >
        Explorar
      </p>
      <ul class="grid grid-cols-2 gap-1.5 text-sm">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="bg-muted/60 hover:bg-muted block rounded-lg px-3 py-2 font-medium"
          >
            Todas las noticias
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "archives")}
            class="bg-muted/60 hover:bg-muted block rounded-lg px-3 py-2 font-medium"
          >
            Archivo cronológico
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class="bg-muted/60 hover:bg-muted block rounded-lg px-3 py-2 font-medium"
          >
            Todas las etiquetas
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class="bg-muted/60 hover:bg-muted block rounded-lg px-3 py-2 font-medium"
          >
            Acerca de Ping Diario
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const drawer = document.querySelector<HTMLElement>("#mobile-nav-drawer");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !drawer || !menuIcon || !closeIcon) return;
    if (menuBtn.dataset.menuBound === "true") return;
    menuBtn.dataset.menuBound = "true";

    const openLabel = menuBtn.dataset.labelOpen ?? "Abrir menú";
    const closeLabel = menuBtn.dataset.labelClose ?? "Cerrar menú";

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
      menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);

      drawer.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
