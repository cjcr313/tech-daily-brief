---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import "dayjs/locale/es";
import IconRss from "@/assets/icons/IconRss.svg";
import IconInstagram from "@/assets/icons/socials/instagram.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FeaturedHero from "@/components/FeaturedHero.astro";
import NewsCard from "@/components/NewsCard.astro";
import Pagination from "@/components/Pagination.astro";
import { CORE_CATEGORIES } from "@/utils/categories";
import { getMainSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sortedPosts = getMainSortedPosts(posts);
  return paginate(sortedPosts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const isFirstPage = page.currentPage === 1;

// Page 1: Bento Hero (1 lead + 2 side stories) + 9 cards (exact 3x3 grid)
// Pages 2+: 12 cards (exact 4x3 grid), no repeated fake hero
const heroPost = isFirstPage ? page.data[0] : undefined;
const sidePosts = isFirstPage ? page.data.slice(1, 3) : [];
const gridPosts = isFirstPage ? page.data.slice(3) : page.data;

const homePath = getRelativeLocaleUrl(locale, "");
const rssUrl = new URL(
  getRelativeLocaleUrl(locale, "rss.xml"),
  config.site.url
).href;
const archivePath = getRelativeLocaleUrl(locale, "posts");

// Compute live counts for the 8 core sections on Page 1
let categoryCounts: { slug: string; label: string; dotClass: string; count: number }[] = [];
let latestEditionDate = "";

if (isFirstPage) {
  const allPosts = getMainSortedPosts(
    await getCollection("posts", ({ data }) => !data.draft)
  );
  const slugCounts = new Map<string, number>();
  for (const p of allPosts) {
    for (const s of new Set(slugifyAll(p.data.tags))) {
      slugCounts.set(s, (slugCounts.get(s) ?? 0) + 1);
    }
  }
  categoryCounts = CORE_CATEGORIES.map(c => ({
    slug: c.slug,
    label: c.label,
    dotClass: c.dotClass,
    count: slugCounts.get(c.slug) ?? 0,
  }));

  if (heroPost) {
    const dt = dayjs(heroPost.data.modDatetime ?? heroPost.data.pubDatetime)
      .tz(config.site.timezone)
      .locale("es");
    const raw = dt.format("dddd, D [de] MMMM [de] YYYY");
    latestEditionDate = raw.charAt(0).toUpperCase() + raw.slice(1);
  }
}
---

<Layout
  title={
    isFirstPage ? undefined : `Página ${page.currentPage} · ${config.site.title}`
  }
  noindex={!isFirstPage}
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-6"
  >
    <h1 class="sr-only">
      Ping Diario — Noticias diarias de Cloud Native, IA, Kubernetes y Seguridad
    </h1>

    {
      isFirstPage ? (
        <section class="border-border flex flex-col justify-between gap-2 border-b py-5 sm:flex-row sm:items-center">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="font-mono bg-accent-soft text-accent inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-semibold">
              <span class="bg-accent size-1.5 rounded-full" aria-hidden="true" />
              Edición diaria
            </span>
            {latestEditionDate && (
              <span class="font-mono text-muted-foreground text-xs">
                {latestEditionDate}
              </span>
            )}
          </div>
          <p class="text-muted-foreground text-sm">
            Lo esencial en Cloud Native, IA, Seguridad e Infraestructura — sin ruido.
          </p>
        </section>
      ) : (
        <section class="border-border flex items-baseline justify-between border-b pt-8 pb-5">
          <div>
            <p class="font-mono text-accent text-xs font-semibold tracking-wider uppercase">
              Archivo de portada
            </p>
            <h2 class="font-display text-foreground mt-1 text-2xl font-extrabold tracking-tight sm:text-3xl">
              Más noticias · Página {page.currentPage}
            </h2>
          </div>
          <a
            href={homePath}
            class="font-mono text-accent text-xs font-semibold hover:underline"
          >
            ← Volver a portada
          </a>
        </section>
      )
    }

    {
      heroPost && (
        <div class="pt-6 sm:pt-8">
          <FeaturedHero post={heroPost} sidePosts={sidePosts} />
        </div>
      )
    }

    {
      gridPosts.length > 0 && (
        <section class="pt-10 sm:pt-12">
          <div class="flex items-baseline justify-between gap-4">
            <div>
              <h2 class="font-display text-foreground text-xl font-extrabold tracking-tight sm:text-2xl">
                {isFirstPage ? "Últimas noticias" : "Artículos"}
              </h2>
            </div>
            {isFirstPage && (
              <a
                href={archivePath}
                class="font-mono text-accent text-xs font-semibold hover:underline sm:text-sm"
              >
                Ver archivo completo →
              </a>
            )}
          </div>
          <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {gridPosts.map(post => (
              <NewsCard post={post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      isFirstPage && categoryCounts.length > 0 && (
        <section class="pt-12">
          <div class="bg-surface border-border rounded-3xl border p-6 shadow-xs sm:p-8">
            <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
              <div>
                <p class="font-mono text-accent text-xs font-semibold tracking-wider uppercase">
                  Radar temático
                </p>
                <h2 class="font-display text-foreground mt-1 text-xl font-extrabold tracking-tight sm:text-2xl">
                  Explora por especialidad
                </h2>
              </div>
              <a
                href={getRelativeLocaleUrl(locale, "tags")}
                class="font-mono text-accent text-xs font-semibold hover:underline"
              >
                Ver todas las etiquetas →
              </a>
            </div>

            <ul class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
              {categoryCounts.map(cat => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, `tags/${cat.slug}`)}
                    class="border-border bg-background hover:border-accent/60 hover:bg-muted/50 flex items-center justify-between rounded-xl border px-3.5 py-3 transition-colors"
                  >
                    <span class="flex items-center gap-2 text-sm font-semibold">
                      <span
                        class:list={["size-2 rounded-full", cat.dotClass]}
                        aria-hidden="true"
                      />
                      {cat.label}
                    </span>
                    <span class="font-mono text-muted-foreground text-xs">
                      {cat.count}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      isFirstPage && (
        <section class="pt-8">
          <div class="border-border bg-muted/45 flex flex-col items-start justify-between gap-5 rounded-3xl border p-6 sm:p-8 md:flex-row md:items-center">
            <div class="max-w-xl">
              <p class="font-mono text-accent text-xs font-semibold tracking-wider uppercase">
                Sigue el pulso diario
              </p>
              <h2 class="font-display text-foreground mt-1 text-lg font-extrabold tracking-tight sm:text-xl">
                Recibe Ping Diario en tu lector RSS o en Instagram
              </h2>
              <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
                Cada actualización se publica en nuestro feed RSS (compatible
                con Feedly, Inoreader, NetNewsWire y Slack) y en{" "}
                <span class="text-foreground font-medium">@pingdiario</span>.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <button
                type="button"
                id="copy-rss-btn"
                data-rss-url={rssUrl}
                class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold shadow-xs transition-opacity hover:opacity-90"
              >
                <IconRss class="size-4" />
                <span data-rss-label>Copiar enlace RSS</span>
              </button>
              <a
                href="https://www.instagram.com/pingdiario/"
                target="_blank"
                rel="noopener noreferrer"
                class="border-border bg-surface text-foreground hover:border-accent hover:text-accent inline-flex items-center gap-2 rounded-xl border px-4 py-2.5 text-sm font-semibold transition-colors"
              >
                <IconInstagram class="size-4" />
                <span>@pingdiario</span>
              </a>
            </div>
          </div>
        </section>
      )
    }

    <div class="pt-10">
      <Pagination page={page} base="" />
    </div>
  </main>
  <Footer noMarginTop />
</Layout>

<script>
  function initHomeHelpers() {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    const rssBtn = document.querySelector<HTMLButtonElement>("#copy-rss-btn");
    if (rssBtn && rssBtn.dataset.bound !== "true") {
      rssBtn.dataset.bound = "true";
      rssBtn.addEventListener("click", async () => {
        const url = rssBtn.dataset.rssUrl;
        const label = rssBtn.querySelector<HTMLElement>("[data-rss-label]");
        if (!url || !label) return;
        try {
          await navigator.clipboard.writeText(url);
          const original = label.textContent;
          label.textContent = "¡Enlace RSS copiado!";
          setTimeout(() => {
            label.textContent = original;
          }, 2000);
        } catch {
          window.open(url, "_blank", "noopener,noreferrer");
        }
      });
    }
  }

  initHomeHelpers();
  document.addEventListener("astro:page-load", initHomeHelpers);
</script>
