---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="group bg-surface border-border hover:border-accent/60 flex items-start gap-3 rounded-2xl border p-4 transition-colors"
      >
        <IconArrowLeft class="text-muted-foreground group-hover:text-accent mt-0.5 size-5 shrink-0 transition-colors rtl:rotate-180" />
        <div class="min-w-0">
          <span class="font-mono text-muted-foreground block text-[11px] font-semibold tracking-wider uppercase">
            {t.post.previousPost}
          </span>
          <div class="font-display text-foreground group-hover:text-accent mt-1 line-clamp-2 text-sm font-bold transition-colors">
            {prevPost.title}
          </div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="group bg-surface border-border hover:border-accent/60 flex items-start justify-end gap-3 rounded-2xl border p-4 text-end transition-colors sm:col-start-2"
      >
        <div class="min-w-0">
          <span class="font-mono text-muted-foreground block text-[11px] font-semibold tracking-wider uppercase">
            {t.post.nextPost}
          </span>
          <div class="font-display text-foreground group-hover:text-accent mt-1 line-clamp-2 text-sm font-bold transition-colors">
            {nextPost.title}
          </div>
        </div>
        <IconArrowRight class="text-muted-foreground group-hover:text-accent mt-0.5 size-5 shrink-0 transition-colors rtl:rotate-180" />
      </a>
    )
  }
</div>
