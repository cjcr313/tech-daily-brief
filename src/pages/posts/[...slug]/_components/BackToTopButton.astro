---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div
  id="btt-btn-container"
  class="pointer-events-none fixed inset-e-5 bottom-6 z-40 translate-y-4 opacity-0 transition-all duration-300"
>
  <button
    type="button"
    data-button="back-to-top"
    aria-label={t.post.backToTop}
    class="bg-surface/90 border-border text-foreground hover:border-accent hover:text-accent pointer-events-auto inline-flex items-center gap-1.5 rounded-full border px-3.5 py-2 text-xs font-semibold shadow-lg backdrop-blur-md transition-colors"
  >
    <IconArrowNarrowUp class="size-4" />
    <span class="hidden sm:inline">{t.post.backToTop}</span>
  </button>
</div>

<script>
  let bttCleanup: (() => void) | null = null;

  function setupBackToTop() {
    if (bttCleanup) {
      bttCleanup();
      bttCleanup = null;
    }

    const container = document.querySelector<HTMLElement>("#btt-btn-container");
    const btn = document.querySelector<HTMLButtonElement>(
      "[data-button='back-to-top']"
    );
    if (!container || !btn) return;

    if (btn.dataset.bound !== "true") {
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    let ticking = false;
    let lastVisible: boolean | null = null;

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        const scrollable =
          document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
        const visible = ratio > 0.25;

        if (visible !== lastVisible) {
          container.classList.toggle("opacity-100", visible);
          container.classList.toggle("translate-y-0", visible);
          container.classList.toggle("opacity-0", !visible);
          container.classList.toggle("translate-y-4", !visible);
          lastVisible = visible;
        }
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    bttCleanup = () => window.removeEventListener("scroll", onScroll);
  }

  setupBackToTop();
  document.addEventListener("astro:page-load", setupBackToTop);
  document.addEventListener("astro:before-swap", () => {
    if (bttCleanup) {
      bttCleanup();
      bttCleanup = null;
    }
  });
</script>
