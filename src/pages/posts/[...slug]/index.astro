---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import NewsCard from "@/components/NewsCard.astro";
import { getPostSlug } from "@/utils/getPostPaths";
import { getSortedPosts, getMainSortedPosts } from "@/utils/getSortedPosts";
import { getPostCover } from "@/utils/postCover";
import { getCategoryMeta } from "@/utils/categories";
import { getReadingTimeMinutes, getRelatedPosts } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "./_components/EditPost.astro";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const allSortedPosts = getSortedPosts(posts);
  const mainPosts = getMainSortedPosts(posts);
  const enPosts = allSortedPosts.filter(
    (p: CollectionEntry<"posts">) =>
      p.id.endsWith("-en.md") || p.id.endsWith("-en.mdx")
  );

  const buildPaths = (group: CollectionEntry<"posts">[]) =>
    group.map((post, index) => ({
      params: { slug: getPostSlug(post.id, post.filePath) },
      props: {
        post,
        relatedPosts: getRelatedPosts(post, group, 3),
        prevPost:
          index > 0
            ? {
                id: group[index - 1].id,
                title: group[index - 1].data.title,
                filePath: group[index - 1].filePath,
              }
            : null,
        nextPost:
          index < group.length - 1
            ? {
                id: group[index + 1].id,
                title: group[index + 1].data.title,
                filePath: group[index + 1].filePath,
              }
            : null,
      },
    }));

  return [...buildPaths(mainPosts), ...buildPaths(enPosts)];
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  relatedPosts: CollectionEntry<"posts">[];
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, relatedPosts, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const hasSidebarToc = tocHeadings.length >= 2;

const primaryCategory = getCategoryMeta(tags?.[0]);
const readingTime = getReadingTimeMinutes(post.body);

// Use the article's own cover image for Open Graph previews (fallback to default-og.jpg)
const cover = getPostCover(post);
const ogImage =
  cover?.url && !cover.isSvg
    ? new URL(cover.url, Astro.site ?? Astro.url).href
    : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  tags={tags}
  author={config.site.author}
>
  <div id="reading-progress" aria-hidden="true"></div>

  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={[
      "app-layout pb-6",
      { "mt-8": !config.features.showBackButton },
    ]}
    data-pagefind-body
  >
    <!-- Editorial Article Header -->
    <header class:list={["mx-auto", hasSidebarToc ? "max-w-5xl" : "max-w-3xl"]}>
      <nav
        aria-label="Ruta de navegación"
        class="font-mono text-muted-foreground mb-4 flex flex-wrap items-center gap-1.5 text-xs"
      >
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="hover:text-accent transition-colors"
        >
          Inicio
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={getRelativeLocaleUrl(locale, `tags/${primaryCategory.slug}`)}
          class="hover:text-accent transition-colors"
        >
          {primaryCategory.label}
        </a>
      </nav>

      <div class="mb-3 flex flex-wrap items-center gap-2">
        <a
          href={getRelativeLocaleUrl(locale, `tags/${primaryCategory.slug}`)}
          class:list={[
            "font-mono inline-flex items-center gap-1.5 rounded-full border px-3 py-0.5 text-xs font-semibold tracking-wide uppercase transition-opacity hover:opacity-85",
            primaryCategory.chipClass,
          ]}
        >
          <span
            class:list={["size-1.5 rounded-full", primaryCategory.dotClass]}
            aria-hidden="true"></span>
          {primaryCategory.label}
        </a>
      </div>

      <h1
        style={{ viewTransitionName: toTransitionName(title) }}
        class="font-display text-foreground text-3xl leading-[1.15] font-extrabold tracking-tight sm:text-4xl lg:text-[2.5rem]"
      >
        {title}
      </h1>

      {
        description && (
          <p class="text-muted-foreground mt-4 text-base leading-relaxed sm:text-lg">
            {description}
          </p>
        )
      }

      <div
        class="border-border mt-6 flex flex-wrap items-center justify-between gap-4 border-y py-3.5"
      >
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-foreground text-sm font-semibold">
            {config.site.author}
          </span>
          <span aria-hidden="true" class="text-muted-foreground opacity-50">
            ·
          </span>
          <Datetime
            {pubDatetime}
            {modDatetime}
            {timezone}
            readingTime={readingTime}
            size="lg"
          />
          <EditPost {hideEditPost} {post} class="max-sm:hidden" />
        </div>

        <button
          type="button"
          id="copy-link-btn"
          class="border-border bg-surface text-muted-foreground hover:border-accent hover:text-accent font-mono inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors"
        >
          <span data-copy-label>Copiar enlace</span>
        </button>
      </div>
    </header>

    <!-- Article Body + Optional Sticky TOC Sidebar -->
    <div
      class:list={[
        "mx-auto mt-8",
        hasSidebarToc
          ? "grid max-w-5xl grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]"
          : "max-w-3xl",
      ]}
    >
      <div class="min-w-0">
        <article
          id="article"
          class:list={[
            "app-prose mx-auto max-w-[70ch]",
            "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
          ]}
        >
          <Content />
        </article>

        <div class="mx-auto max-w-[70ch]">
          <hr class="border-border my-8" />

          <EditPost class="sm:hidden" {hideEditPost} {post} />

          <BackToTopButton />

          <ul class="mt-4 mb-6 flex flex-wrap gap-2">
            {
              tags.map(tag => (
                <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
              ))
            }
          </ul>

          <ShareLinks />
        </div>
      </div>

      {
        hasSidebarToc && (
          <aside class="hidden lg:block" data-pagefind-ignore>
            <div class="sticky top-28 space-y-6">
              <div class="bg-surface border-border rounded-2xl border p-4 shadow-xs">
                <p class="font-mono text-muted-foreground mb-3 text-[11px] font-semibold tracking-wider uppercase">
                  En este artículo
                </p>
                <nav aria-label="Tabla de contenidos">
                  <ul class="space-y-2 text-xs leading-snug">
                    {tocHeadings.map(heading => (
                      <li class:list={[heading.depth === 3 && "ps-3"]}>
                        <a
                          href={`#${heading.slug}`}
                          class="text-muted-foreground hover:text-accent block transition-colors"
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>

              <div class="border-border bg-muted/40 rounded-2xl border p-4">
                <p class="font-display text-foreground text-sm font-bold">
                  Ping Diario
                </p>
                <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
                  Resumen diario de tecnología e infraestructura. Síguenos en{" "}
                  <a
                    href="https://www.instagram.com/pingdiario/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent font-semibold hover:underline"
                  >
                    @pingdiario
                  </a>
                  .
                </p>
              </div>
            </div>
          </aside>
        )
      }
    </div>

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section
          data-pagefind-ignore
          class:list={[
            "border-border mx-auto mt-14 border-t pt-10",
            hasSidebarToc ? "max-w-5xl" : "max-w-5xl",
          ]}
        >
          <div class="flex items-baseline justify-between gap-4">
            <div>
              <p class="font-mono text-accent text-xs font-semibold tracking-wider uppercase">
                Sigue leyendo
              </p>
              <h2 class="font-display text-foreground mt-1 text-xl font-extrabold tracking-tight sm:text-2xl">
                Noticias relacionadas
              </h2>
            </div>
            <a
              href={getRelativeLocaleUrl(locale, `tags/${primaryCategory.slug}`)}
              class="font-mono text-accent text-xs font-semibold hover:underline"
            >
              Más en {primaryCategory.label} →
            </a>
          </div>
          <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map(rel => (
              <NewsCard post={rel} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="border-border mx-auto mt-10 max-w-5xl border-t pt-4">
      <AdjacentPostNav {prevPost} {nextPost} />
    </div>
  </main>

  <Footer />
</PostLayout>

<script>
  let scrollCleanup: (() => void) | null = null;

  function setupReadingProgressFallback() {
    if (scrollCleanup) {
      scrollCleanup();
      scrollCleanup = null;
    }

    // Native CSS scroll-driven animation handles modern browsers with zero JS
    if (CSS.supports("animation-timeline", "scroll()")) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const bar = document.querySelector<HTMLElement>("#reading-progress");
    if (!bar) return;

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        const scrollable =
          document.documentElement.scrollHeight - window.innerHeight;
        const progress =
          scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
        bar.style.transform = `scaleX(${progress})`;
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    scrollCleanup = () => window.removeEventListener("scroll", onScroll);
  }

  function enhanceArticle() {
    // 1. Heading anchor links (idempotent)
    const article = document.querySelector("#article");
    if (article) {
      article
        .querySelectorAll<HTMLElement>("h2[id], h3[id], h4[id]")
        .forEach(heading => {
          if (heading.querySelector(".heading-link")) return;
          heading.classList.add("group");
          const link = document.createElement("a");
          link.className =
            "heading-link ms-2 text-muted-foreground hover:text-accent no-underline opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100";
          link.href = `#${heading.id}`;
          link.setAttribute("aria-label", `Enlace a ${heading.textContent ?? "sección"}`);
          link.textContent = "#";
          heading.appendChild(link);
        });

      // 2. Spanish copy buttons on code blocks (idempotent)
      article.querySelectorAll<HTMLPreElement>("pre").forEach(codeBlock => {
        if (codeBlock.dataset.copyBound === "true") return;
        codeBlock.dataset.copyBound = "true";

        const wrapper = document.createElement("div");
        wrapper.style.position = "relative";

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "copy-code font-mono absolute end-3 top-3 rounded-md border border-border bg-surface/90 px-2 py-1 text-xs font-medium text-foreground shadow-xs backdrop-blur-xs transition-colors hover:border-accent hover:text-accent";
        btn.textContent = "Copiar";

        codeBlock.setAttribute("tabindex", "0");
        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);
        wrapper.appendChild(btn);

        btn.addEventListener("click", async () => {
          const text = codeBlock.querySelector("code")?.innerText ?? "";
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "¡Copiado!";
            setTimeout(() => {
              btn.textContent = "Copiar";
            }, 1500);
          } catch {
            btn.textContent = "Error";
          }
        });
      });
    }

    // 3. Copy article URL button
    const copyLinkBtn =
      document.querySelector<HTMLButtonElement>("#copy-link-btn");
    if (copyLinkBtn && copyLinkBtn.dataset.bound !== "true") {
      copyLinkBtn.dataset.bound = "true";
      copyLinkBtn.addEventListener("click", async () => {
        const label =
          copyLinkBtn.querySelector<HTMLElement>("[data-copy-label]");
        if (!label) return;
        try {
          await navigator.clipboard.writeText(window.location.href);
          const original = label.textContent;
          label.textContent = "¡Enlace copiado!";
          setTimeout(() => {
            label.textContent = original;
          }, 1800);
        } catch {
          // ignore
        }
      });
    }

    setupReadingProgressFallback();
  }

  enhanceArticle();
  document.addEventListener("astro:page-load", enhanceArticle);
  document.addEventListener("astro:before-swap", () => {
    if (scrollCleanup) {
      scrollCleanup();
      scrollCleanup = null;
    }
  });
</script>
