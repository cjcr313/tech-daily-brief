---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`} noindex>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center py-16"
  >
    <div class="max-w-md text-center">
      <p
        class="font-mono text-accent text-xs font-semibold tracking-widest uppercase"
      >
        Error 404
      </p>
      <h1
        class="font-display text-foreground mt-2 text-5xl font-extrabold tracking-tight sm:text-6xl"
      >
        Página no encontrada
      </h1>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
        El enlace que buscas puede haber cambiado o no existe en Ping Diario.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="bg-accent text-accent-foreground rounded-xl px-5 py-2.5 text-sm font-semibold shadow-xs transition-opacity hover:opacity-90"
        >
          {t.notFound.goHome}
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          data-open-search
          class="border-border bg-surface text-foreground hover:border-accent hover:text-accent rounded-xl border px-5 py-2.5 text-sm font-semibold transition-colors"
        >
          Buscar artículo
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
