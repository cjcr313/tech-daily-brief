---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import SearchModal from "@/components/SearchModal.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
};

const { site } = config;

const {
  title = `${site.title} · Noticias de Cloud Native, IA, Seguridad e Infraestructura`,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogType = "website",
  noindex = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url).href;
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
);

const isHome =
  Astro.url.pathname === "/" || Astro.url.pathname === import.meta.env.BASE_URL;

const websiteSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.title,
      url: site.url,
      description: site.description,
      inLanguage: "es",
      publisher: {
        "@type": "Organization",
        name: "Nauta Lab",
        url: site.url,
        sameAs: ["https://www.instagram.com/pingdiario/"],
      },
      potentialAction: {
        "@type": "SearchAction",
        target: `${site.url.replace(/\/$/, "")}/search/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    }
  : null;
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- FOUC-prevention script: applies stored color-scheme override before first paint -->
    <script is:inline>
      (function () {
        try {
          var stored =
            localStorage.getItem("color-scheme") ||
            localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            var meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) meta.setAttribute("content", stored);
            document.documentElement.setAttribute("data-theme", stored);
            document.documentElement.classList.toggle(
              "dark",
              stored === "dark"
            );
          } else {
            var isDark = window.matchMedia(
              "(prefers-color-scheme: dark)"
            ).matches;
            document.documentElement.setAttribute(
              "data-theme",
              isDark ? "dark" : "light"
            );
            document.documentElement.classList.toggle("dark", isDark);
          }
        } catch (e) {}
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" sizes="32x32" href={getAssetPath("favicon.ico")} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={getAssetPath("apple-touch-icon.png")}
    />
    <link rel="manifest" href={getAssetPath("site.webmanifest")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Fonts -->
    <Font
      cssVariable="--font-display"
      preload={[{ subset: "latin", weight: 700, style: "normal" }]}
    />
    <Font
      cssVariable="--font-sans"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font cssVariable="--font-mono" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="#fafbfc" />

    {
      websiteSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(websiteSchema)}
        />
      )
    }

    <!-- Extra head content injected by child layouts (e.g. NewsArticle JSON-LD) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/20 selection:text-foreground flex min-h-svh flex-col"
  >
    <slot />
    {config.features.search !== false && <SearchModal />}
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
